<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Student Login | TLMPS</title><style>:root{--p:#3b1c56;--m:#5c2d91;--l:#f4f0fa;--g:#84cc16;--i:#1e293b}*{box-sizing:border-box}body{min-height:100vh;margin:0;display:grid;place-items:center;padding:28px 16px;background:radial-gradient(circle at 7% 8%,#dfd0fb 0,transparent 32%),radial-gradient(circle at 94% 90%,#e2f7b9 0,transparent 28%),var(--l);font:15px 'Segoe UI',sans-serif;color:var(--i)}.card{width:min(100%,430px);padding:38px;background:#fff;border:1px solid #e7ddf3;border-radius:24px;box-shadow:0 22px 55px #3b1c5626;text-align:center}.logo{width:86px;height:86px;object-fit:contain}.tag{margin:9px 0;color:#65a30d;font-size:11px;font-weight:800;letter-spacing:1.3px;text-transform:uppercase}h1{margin:0;color:var(--p);font-size:30px}.sub{margin:9px 0 24px;color:#64748b}.notice{padding:12px;margin-bottom:16px;border-radius:10px;text-align:left;font-size:13px}.error{background:#fff1f2;color:#9f1239}.success{background:#f0fdf4;color:#166534}label{display:block;margin:14px 0 6px;text-align:left;color:#475569;font-size:11px;font-weight:800;letter-spacing:.5px;text-transform:uppercase}input{width:100%;padding:13px 14px;border:1px solid #ddd0ef;border-radius:10px;font:inherit}input:focus{outline:0;border-color:var(--m);box-shadow:0 0 0 4px #eadcff}.pass{position:relative}.eye{position:absolute;right:13px;bottom:12px;cursor:pointer}.link{display:block;margin-top:14px;color:var(--m);font-weight:700;line-height:1.45}button{width:100%;margin-top:22px;padding:13px;border:0;border-radius:10px;background:var(--p);color:#fff;font:800 16px inherit;cursor:pointer}button:hover{background:var(--m)}footer{margin-top:26px;color:#94a3b8;font-size:12px}@media(max-width:440px){.card{padding:28px 22px;border-radius:19px}h1{font-size:26px}}</style></head><body><main class="card"><img class="logo" src="/img/tlmps_llogo_compressed_no_bg.png" alt="TLMPS logo"><p class="tag">The Leaders Memorial Private School</p><h1>Student Portal</h1><p class="sub">Sign in to view your school results.</p><% if(error){ %><div class="notice error"><%= error %></div><% } %><% if(typeof success !== 'undefined' && success){ %><div class="notice success"><%= success %></div><% } %><form action="/login" method="post" autocomplete="off"><label>Admission number</label><input name="admission_no" placeholder="e.g. 29001" required><div class="pass"><label>Password</label><input id="passwordField" type="password" name="surname" placeholder="Enter your password" required><span class="eye" onclick="toggleVisibility()">👁</span></div><a class="link" href="https://tlmps.netlify.app/bece/bece_login">Check your BECE result</a><a class="link" href="/forgot-password">Forgot password or admission number?</a><button>Login to Portal</button></form><footer>© <span id="year"></span> The Leaders Memorial Private School</footer></main><script>function toggleVisibility(){let e=document.getElementById('passwordField');e.type=e.type==='password'?'text':'password'}year.textContent=new Date().getFullYear()</script></body></html>
