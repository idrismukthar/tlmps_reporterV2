<!doctype html>
<html lang="en">
  <head>
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link rel="manifest" href="/site.webmanifest">
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Students can sign in to view their academic performance, term results, report cards, and school records.">
    <meta property="og:type" content="website">
    <meta property="og:title" content="Student Portal | TLMPS">
    <meta property="og:description" content="Sign in to view your school results.">
    <meta property="og:image" content="https://tlmps.netlify.app/tlmps_llogo.png">
    <meta property="og:image:alt" content="The Leaders Memorial Private School logo">
    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="Student Portal | TLMPS">
    <meta name="twitter:description" content="Sign in to view your school results.">
    <meta name="twitter:image" content="https://tlmps.netlify.app/tlmps_llogo.png">
    <title>Student Login | TLMPS</title>
    <style>
      :root{--p:#3b1c56;--m:#5c2d91;--l:#f4f0fa;--g:#84cc16;--i:#1e293b}
      *{box-sizing:border-box}
      body{min-height:100vh;margin:0;display:grid;place-items:center;padding:28px 16px;background:radial-gradient(circle at 7% 8%,#dfd0fb 0,transparent 32%),radial-gradient(circle at 94% 90%,#e2f7b9 0,transparent 28%),var(--l);font:15px 'Segoe UI',sans-serif;color:var(--i)}
      .card{width:min(100%,430px);padding:38px;background:#fff;border:1px solid #e7ddf3;border-radius:24px;box-shadow:0 22px 55px #3b1c5626;text-align:center}
      .logo{width:86px;height:86px;object-fit:contain}
      .tag{margin:9px 0;color:#65a30d;font-size:11px;font-weight:800;letter-spacing:1.3px;text-transform:uppercase}
      h1{margin:0;color:var(--p);font-size:30px}
      .sub{margin:9px 0 24px;color:#64748b}
      .notice{padding:12px;margin-bottom:16px;border-radius:10px;text-align:left;font-size:13px}
      .error{background:#fff1f2;color:#9f1239}
      .success{background:#f0fdf4;color:#166534}
      label{display:block;margin:14px 0 6px;text-align:left;color:#475569;font-size:11px;font-weight:800;letter-spacing:.5px;text-transform:uppercase}
      input{width:100%;padding:13px 14px;border:1px solid #ddd0ef;border-radius:10px;font:inherit}
      input:focus{outline:0;border-color:var(--m);box-shadow:0 0 0 4px #eadcff}
      .pass{position:relative}
      .eye{position:absolute;right:13px;bottom:12px;cursor:pointer}
      .link{display:block;margin-top:14px;color:var(--m);font-weight:700;line-height:1.45}
      .hint{margin:8px 0 0;color:#64748b;font-size:12px;text-align:left}
      button{width:100%;margin-top:22px;padding:13px;border:0;border-radius:10px;background:var(--p);color:#fff;font:800 16px 'Segoe UI',sans-serif;cursor:pointer}
      button:hover{background:var(--m)}
      footer{margin-top:18px;color:#94a3b8;font-size:12px}
      @media(max-width:440px){.card{padding:28px 22px;border-radius:19px}h1{font-size:26px}}
    </style>
  </head>
  <body>
    <main class="card">
      <img class="logo" src="/img/tlmps_llogo_compressed_no_bg.png" alt="TLMPS logo">
      <p class="tag">The Leaders Memorial Private School</p>
      <h1>Student Portal</h1>
      <p class="sub">Sign in to view your school results.</p>
      <% if(error){ %><div class="notice error"><%= error %></div><% } %>
      <% if(success){ %><div class="notice success"><%= success %></div><% } %>
      <form action="/login" method="post" autocomplete="on">
        <label for="admissionNo">Admission number</label>
        <input id="admissionNo" name="admission_no" inputmode="numeric" autocomplete="username" placeholder="e.g. 29001" required>
        <div class="pass">
          <label for="passwordField">Password</label>
          <input id="passwordField" type="password" name="password" autocomplete="current-password" placeholder="Enter your password" required>
          <span class="eye" role="button" tabindex="0" aria-label="Show password" onclick="toggleVisibility()" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();toggleVisibility()}">👁</span>
        </div>
        <p class="hint">password example: surname + last three admission-number digits (Wale, 26001 → wale001).</p>
        <a class="link" href="https://tlmps.netlify.app/bece/bece_login">Check your BECE result</a>
        <a class="link" href="/forgot-password">Forgot password or admission number?</a>
        <button type="submit">Login to Portal</button>
      </form>
      <footer>© <span id="year"></span> The Leaders Memorial Private School</footer>
    </main>
    <script>
      function toggleVisibility() {
        const field = document.getElementById("passwordField");
        field.type = field.type === "password" ? "text" : "password";
      }
      document.getElementById("year").textContent = new Date().getFullYear();
    </script>
  </body>
</html>
