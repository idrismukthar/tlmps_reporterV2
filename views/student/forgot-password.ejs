<!doctype html><html><head><link rel="icon" type="image/x-icon" href="/favicon.ico"><link rel="manifest" href="/site.webmanifest"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Recover account | TLMPS</title><style>body{margin:0;min-height:100vh;display:grid;place-items:center;background:#f4f0fa;font:15px Segoe UI,sans-serif;color:#1e293b}.card{width:min(420px,calc(100% - 40px));padding:30px;background:#fff;border-radius:18px;box-shadow:0 15px 40px #3b1c5622;text-align:center}.logo{width:70px}h1{color:#3b1c56}.tabs{display:flex;gap:8px}.tab,button{border:0;border-radius:8px;padding:11px;cursor:pointer;font-weight:700}.tab{flex:1}.active,button[type=submit]{background:#3b1c56!important;color:#fff}.panel{display:none;text-align:left}.panel.active{display:block}label,input{display:block;width:100%;box-sizing:border-box}label{margin:14px 0 5px;font-weight:700}input{padding:12px;border:1px solid #d8c8ef;border-radius:8px}button[type=submit]{width:100%;margin-top:18px}.notice{padding:12px;margin:14px 0;border-radius:8px}.error{background:#fff0f0;color:#9b1c1c}.result{background:#ecfccb;color:#365314}a{color:#5c2d91;font-weight:700}</style></head><body><main class="card"><img class="logo" src="/img/tlmps_llogo_compressed_no_bg.png"><h1>Recover your account</h1><p>Verify your parent phone number to recover access.</p><% if(error){ %><div class="notice error"><%= error %></div><% } %><% if(result){ %><div class="notice result">Admission number: <b id="value"><%= result %></b> <button type="button" onclick="navigator.clipboard.writeText(value.textContent);this.textContent='Copied'">Copy</button></div><% } %><% if(resetReady){ %><form action="/reset-password" method="post"><label>New password</label><input name="password" type="password" minlength="8" required><label>Confirm password</label><input name="confirm_password" type="password" minlength="8" required><button>Set new password</button></form><% } else { %><div class="tabs"><button class="tab active" type="button" data-tab="reset">Forgot password</button><button class="tab" type="button" data-tab="admission">Forgot admission no.</button></div><form class="panel active" id="reset" action="/forgot-password" method="post"><input type="hidden" name="action" value="reset"><label>Parent phone number</label><input name="phone_number" required><label>Admission number</label><input name="admission_no" required><button>Verify and reset password</button></form><form class="panel" id="admission" action="/forgot-password" method="post"><input type="hidden" name="action" value="admission"><label>Parent phone number</label><input name="phone_number" required><label>Current password</label><input name="current_password" type="password" required><button>Find admission number</button></form><% } %><p><a href="/login">Back to login</a></p></main><script>document.querySelectorAll('.tab').forEach(b=>b.onclick=()=>{document.querySelectorAll('.tab,.panel').forEach(x=>x.classList.remove('active'));b.classList.add('active');document.getElementById(b.dataset.tab).classList.add('active')})</script></body></html>
