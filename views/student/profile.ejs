<!DOCTYPE html>
<!--[if IE 8]> <html lang="en" class="ie8"> <![endif]-->
<!--[if IE 9]> <html lang="en" class="ie9"> <![endif]-->
<!--[if !IE]><!--> <html lang="en"> <!--<![endif]-->
<head><link rel="icon" type="image/x-icon" href="/favicon.ico"><link rel="manifest" href="/site.webmanifest">
	<title>Student Profile | TLMPS</title>

	<!-- Meta -->
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">

	<!-- Local Styles for Offline Support -->
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .profile-page { background: var(--lilac); }
        .profile-content { padding-top: 94px; padding-bottom: 48px; }
        .profile-layout { align-items: flex-start; }
        .profile-main { padding-left: 24px; }
        .profile-intro { margin: 0 0 24px; }
        .profile-eyebrow { margin: 0 0 7px; color: var(--dark-lemon); font-size: 11px; font-weight: 800; letter-spacing: 1.2px; text-transform: uppercase; }
        .profile-intro h1 { margin: 0; color: var(--primary); font-size: clamp(25px, 3vw, 34px); letter-spacing: -.9px; }
        .profile-intro p:last-child { margin: 8px 0 0; color: var(--mid-slate); line-height: 1.6; }
        #profile-sidebar .sidebar-nav-v1 { overflow: hidden; border-radius: 18px; border: 1px solid rgba(59,28,86,.08); box-shadow: 0 10px 28px rgba(59,28,86,.08); }
        .profile-identity { padding: 26px 20px; background: var(--primary); color: var(--white); text-align: center; }
        .profile-identity .profile-img { width: 88px; height: 88px; margin: 0 auto 14px; border: 3px solid rgba(255,255,255,.9); border-radius: 50%; object-fit: cover; }
        .profile-identity h4 { margin: 0 0 10px; color: var(--white); font-size: 18px; font-weight: 800; }
        .profile-meta { display: flex; justify-content: center; flex-wrap: wrap; gap: 7px; }
        .profile-meta span { padding: 5px 10px; border-radius: 999px; background: rgba(255,255,255,.14); color: var(--white); font-size: 11px; font-weight: 700; }
        .profile-meta .profile-class { background: var(--lemon); color: var(--dark-slate); }
        #profile-sidebar .list-group { margin: 0; padding: 10px; }
        #profile-sidebar .list-group-item { margin: 2px 0; border: 0; border-radius: 10px; }
        #profile-sidebar .list-group-item a { display: block; padding: 11px 12px; color: var(--mid-slate); font-weight: 700; text-decoration: none; }
        #profile-sidebar .list-group-item.active { background: var(--primary); }
        #profile-sidebar .list-group-item.active a { color: var(--white); }
        .profile-main > .row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; margin: 0 0 18px; }
        .profile-main > .row > [class*="col-"] { width: auto; padding: 0; }
        .profile-main > .row > .col-md-12 { grid-column: 1 / -1; }
        .profile-detail-card { height: 100%; margin: 0; padding: 24px; border: 1px solid rgba(59,28,86,.07); border-radius: 18px; background: var(--white); box-shadow: 0 2px 8px rgba(59,28,86,.07); }
        .profile-detail-card h3 { margin: 0 0 18px; padding-bottom: 12px; border-bottom: 2px solid var(--lemon); color: var(--primary); font-size: 17px; }
        .detail-row { padding: 12px 0; border-bottom: 1px solid var(--grey-border); }
        .detail-row:last-child { border-bottom: 0; }
        .detail-label { display: block; margin-bottom: 3px; color: var(--mid-slate); font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: .5px; }
        .detail-value { color: var(--dark-slate); font-size: 15px; font-weight: 600; overflow-wrap: anywhere; }
        .profile-subject-list { display: flex; flex-wrap: wrap; gap: 8px; padding: 0; margin: 0; list-style: none; }
        .profile-subject-list li { padding: 8px 11px; border-radius: 999px; background: var(--light-purple); color: var(--primary); font-size: 12px; font-weight: 700; }
        .attendance-summary-section { margin-top: 25px; }
        .attendance-summary-heading { margin: 0 0 14px; color: var(--primary); font-size: 20px; }
        .attendance-summary-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 14px; }
        .attendance-summary-card { padding: 18px; border: 1px solid rgba(59,28,86,.08); border-radius: 16px; background: linear-gradient(145deg, #fff, #f7f0ff); box-shadow: 0 3px 10px rgba(59,28,86,.07); }
        .attendance-summary-card h4 { margin: 0 0 14px; color: var(--primary); font-size: 16px; }
        .attendance-summary-values { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
        .attendance-summary-value { padding: 10px 5px; border-radius: 10px; background: rgba(255,255,255,.9); text-align: center; }
        .attendance-summary-value strong { display: block; color: var(--primary); font-size: 21px; }
        .attendance-summary-value span { display: block; margin-top: 4px; color: var(--mid-slate); font-size: 10px; font-weight: 800; line-height: 1.2; text-transform: uppercase; }
        @media (max-width: 991px) { .profile-content { padding: 86px 15px 32px; } .profile-main { width: 100%; padding: 0; } .profile-layout { margin: 0; } }
        @media (max-width: 600px) { .profile-content { padding: 74px 12px 28px; } .portal-topbar .portal-contact-btn { display: none; } .profile-main > .row { grid-template-columns: 1fr; gap: 14px; margin-bottom: 14px; } .profile-detail-card { padding: 17px; border-radius: 14px; } }
    </style>
</head>
<body class="profile-page">
	<%
        const rawDob = String(student.dob || '').trim();
        let dobDate = null;
        if (/^\d{1,2}\/\d{1,2}\/\d{4}$/.test(rawDob)) {
            const [day, month, year] = rawDob.split('/').map(Number);
            dobDate = new Date(year, month - 1, day);
        } else if (rawDob) {
            const parsed = new Date(rawDob);
            if (!Number.isNaN(parsed.getTime())) dobDate = parsed;
        }
        const ordinal = (day) => {
            const remainder = day % 100;
            return `${day}${remainder >= 11 && remainder <= 13 ? 'th' : ({ 1: 'st', 2: 'nd', 3: 'rd' }[day % 10] || 'th')}`;
        };
        let dobDisplay = 'Not Recorded';
        if (dobDate) {
            const today = new Date();
            let age = today.getFullYear() - dobDate.getFullYear();
            const birthdayReached = today.getMonth() > dobDate.getMonth() || (today.getMonth() === dobDate.getMonth() && today.getDate() >= dobDate.getDate());
            if (!birthdayReached) age--;
            const writtenDate = `${dobDate.toLocaleString('en-US', { weekday: 'long' })} ${ordinal(dobDate.getDate())} ${dobDate.toLocaleString('en-US', { month: 'long' })}, ${dobDate.getFullYear()}`;
            dobDisplay = `${rawDob} (${writtenDate} · ${age} years old)`;
        }
    %>
	<div class="wrapper">
		<div class="portal-topbar"><div class="portal-topbar-inner">
            <a class="portal-topbar-brand" href="/portal"><img src="/img/tlmps_llogo_compressed_no_bg.png" alt="TLMPS logo"><span class="portal-topbar-divider"></span><span class="portal-topbar-text"><span class="portal-topbar-title">The Leaders Memorial Private School</span><span class="portal-topbar-subtitle">Student Profile</span></span></a>
            <div class="portal-topbar-actions"><a href="https://mail.google.com/mail/?view=cm&amp;fs=1&amp;to=contacttlmps%40gmail.com&amp;su=Enquiry%20-%20The%20Leaders%20Memorial%20Private%20School" target="_blank" rel="noopener noreferrer" class="btn-ghost portal-contact-btn"><span>Contact Us</span></a><button type="button" class="student-menu-toggle" aria-controls="profile-sidebar" aria-expanded="false"><span class="menu-icon" aria-hidden="true">&#9776;</span><span class="menu-label">Menu</span></button></div>
        </div></div>

		<div class="container content profile-content">
			<div class="row profile-layout">
				<!-- Sidebar -->
				<div class="col-md-3 md-margin-bottom-40" id="profile-sidebar">
                    <div class="sidebar-nav-v1">
                        <div class="profile-identity">
                            <img class="img-circle profile-img" 
                                 src="<%= student.passport_url || '/img/' + student.admission_no + '.jpg' %>" 
                                 alt="<%= student.surname %>" 
                                 onerror="this.src='/img/default-avatar.png';">
                            <h4><%= student.surname %> <%= student.middle_name || '' %></h4>
                            <div class="profile-meta"><span><%= student.admission_no %></span><span class="profile-class"><%= student.class_name %></span></div>
                        </div>
                        <ul class="list-group student-nav-links" id="profile-student-nav">
                            <li class="list-group-item">
                                <a href="/portal"><i class="fa fa-home"></i> Dashboard</a>
                            </li>
                            <li class="list-group-item">
                                <a href="/audit"><i class="fa fa-bar-chart"></i> Performance Audit</a>
                            </li>
                            <li class="list-group-item active">
                                <a href="/profile"><i class="fa fa-user"></i> My Profile</a>
                            </li>
                            <li class="list-group-item">
                                <a href="/logout"><i class="fa fa-sign-out"></i> Logout</a>
                            </li>
                        </ul>
                    </div>
				</div>

				<!-- Main Content -->
                <div class="col-md-9 profile-main">
                    <div class="profile-intro"><p class="profile-eyebrow">Student record</p><h1>My Profile</h1><p>Your personal details, school information, and academic activity.</p></div>
                    
                    <div class="row">
                        <!-- Bio Data -->
                        <div class="col-md-6">
                            <div class="profile-detail-card">
                                <h3><i class="fa fa-id-card"></i> Personal Information</h3>
                                
                                <div class="detail-row">
                                    <span class="detail-label">Full Name:</span>
                                    <span class="detail-value"><%= student.surname %> <%= student.middle_name || '' %> <%= student.last_name %></span>
                                </div>
                                <div class="detail-row">
                                    <span class="detail-label">Gender:</span>
                                    <span class="detail-value"><%= student.gender %></span>
                                </div>
                                <div class="detail-row">
                                    <span class="detail-label">Date of Birth:</span>
                                    <span class="detail-value"><%= dobDisplay %></span>
                                </div>
                                <div class="detail-row">
                                    <span class="detail-label">State of Origin:</span>
                                    <span class="detail-value"><%= student.state_of_origin || 'Not Record' %></span>
                                </div>
                                <div class="detail-row">
                                    <span class="detail-label">LGA:</span>
                                    <span class="detail-value"><%= student.lga || 'Not Record' %></span>
                                </div>
                            </div>
                        </div>

                         <!-- Contact Info -->
                         <div class="col-md-6">
                            <div class="profile-detail-card">
                                <h3><i class="fa fa-map-marker"></i> Contact Details</h3>
                                
                                <div class="detail-row">
                                    <span class="detail-label">Current Class:</span>
                                    <span class="detail-value"><%= student.class_name %></span>
                                </div>
                                <% if (student.department) { %>
                                <div class="detail-row">
                                    <span class="detail-label">Department:</span>
                                    <span class="detail-value"><%= student.department %></span>
                                </div>
                                <% } %>
                                <div class="detail-row">
                                    <span class="detail-label">Phone Number:</span>
                                    <span class="detail-value"><%= student.phone_number || 'Not Record' %></span>
                                </div>
                                <div class="detail-row">
                                    <span class="detail-label">Email Address:</span>
                                    <span class="detail-value"><%= student.email || 'Not Record' %></span>
                                </div>
                                <div class="detail-row">
                                    <span class="detail-label">Home Address:</span>
                                    <span class="detail-value"><%= student.address || 'Not Record' %></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Voluntary Groups -->
                    <div class="row">
                        <div class="col-md-12">
                            <div class="profile-detail-card">
                                <h3><i class="fa fa-users"></i> Voluntary Groups</h3>
                                <div class="row">
                                    <div class="col-md-12">
                                        <div style="display: flex; gap: 40px; flex-wrap: wrap;">
                                            <div class="detail-row" style="border: none; padding: 0; min-width: 150px;">
                                                <span class="detail-label">Club:</span>
                                                <span class="detail-value"><%= student.club || 'Not Registered' %></span>
                                            </div>
                                            <div class="detail-row" style="border: none; padding: 0; min-width: 150px;">
                                                <span class="detail-label">Society:</span>
                                                <span class="detail-value" style="white-space: nowrap;"><%= student.society || 'Not Registered' %></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Session Performance -->
                    <% const showGpa = /^SSS[1-3]$/i.test(String(student.class_name || '').trim()); %>
                    <% if (sessionSummaries && sessionSummaries.length > 0) { %>
                        <% sessionSummaries.forEach(session => { %>
                            <div class="profile-detail-card" style="margin-top: 25px;">
                                <h3><i class="fa fa-book"></i> <%= session.session_name %> <%= showGpa ? 'Session Performance' : 'Subjects Offered' %></h3>
                                <p style="font-size: 12px; color: #555; margin-top: -8px; margin-bottom: 15px; font-weight: 600;">
                                    Class: <%= session.class_name %>
                                </p>
                                <% if (showGpa) { %>
                                    <div class="table-responsive">
                                        <table class="table table-striped" style="margin-bottom: 0; border: 1px solid #eee;">
                                            <thead>
                                                <tr style="background: #f3e8ff; color: #6a0dad;">
                                                    <th>Term</th>
                                                    <th>GPA</th>
                                                    <th>CGPA</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% session.terms.forEach(term => { %>
                                                    <tr>
                                                        <td><%= term.term_name %></td>
                                                        <td><%= term.gpa == null ? 'N/A' : Number(term.gpa).toFixed(2) %></td>
                                                        <td><%= term.cgpa == null ? 'N/A' : Number(term.cgpa).toFixed(2) %></td>
                                                    </tr>
                                                <% }) %>
                                            </tbody>
                                        </table>
                                    </div>
                                <% } else if (session.subjects && session.subjects.length > 0) { %>
                                    <ul class="profile-subject-list">
                                        <% session.subjects.forEach(subject => { %>
                                            <li><%= subject %></li>
                                        <% }) %>
                                    </ul>
                                <% } else { %>
                                    <p style="color: #888; font-style: italic;">No subjects recorded for this session yet.</p>
                                <% } %>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <div class="profile-detail-card">
                            <h3><i class="fa fa-book"></i> Session Performance</h3>
                            <p style="color: #888; font-style: italic;">No academic session results yet.</p>
                        </div>
                    <% } %>

                    <% if (attendanceSummaries && attendanceSummaries.length > 0) { %>
                        <section class="attendance-summary-section" aria-labelledby="attendance-summary-heading">
                            <h3 class="attendance-summary-heading" id="attendance-summary-heading">Attendance Summary · 2026/2027</h3>
                            <div class="attendance-summary-grid">
                                <% attendanceSummaries.forEach(term => { %>
                                    <article class="attendance-summary-card">
                                        <h4><%= term.term_name %></h4>
                                        <div class="attendance-summary-values">
                                            <div class="attendance-summary-value"><strong><%= term.days_present %></strong><span>Days Present</span></div>
                                            <div class="attendance-summary-value"><strong><%= term.days_absent %></strong><span>Days Absent</span></div>
                                            <div class="attendance-summary-value"><strong><%= term.max_streak %></strong><span>Max Streak</span></div>
                                        </div>
                                    </article>
                                <% }) %>
                            </div>
                        </section>
                    <% } %>

				</div>
			</div>
		</div>
	</div>

    <footer class="footer-v1 portal-footer">
        <div class="container portal-footer-inner">
            <div class="row portal-footer-grid">
                <div class="col-md-4 portal-footer-brand">
                    <img src="/img/tlmps_llogo_compressed_no_bg.png" class="footer-logo" alt="TLMPS logo">
                    <p class="footer-school-name">The Leaders Memorial Private School</p>
                    <p class="footer-tagline">We Nurture the Leaders of tomorrow.</p>
                    <p class="footer-contact"><span><i class="fa fa-map-marker"></i> 17, Shoye Odubana Street, Off Papa Major B/stop, Ijegun-Ikotun, Lagos.</span><span><i class="fa fa-envelope"></i> contacttlmps@gmail.com</span></p>
                </div>
                <div class="col-md-4 portal-footer-social text-center">
                    <h3>Connect With Us</h3>
                    <div class="social-icons">
                        <a href="#" aria-label="Facebook" title="Facebook"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M16 8.05C16 3.6 12.42 0 8 0S0 3.6 0 8.05C0 12.07 2.93 15.4 6.75 16v-5.63H4.72V8.05h2.03V6.28c0-2.02 1.2-3.13 3.02-3.13.88 0 1.79.16 1.79.16v1.98h-1.01c-.99 0-1.3.62-1.3 1.26v1.51h2.22l-.35 2.33H9.25V16C13.07 15.4 16 12.07 16 8.05Z"/></svg></a>
                        <a href="#" aria-label="X" title="X"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18.9 2H22l-6.77 7.73L23.2 22h-6.24l-4.89-6.4L6.47 22H3.36l7.24-8.27L2.95 2h6.4l4.42 5.84L18.9 2Zm-1.09 18h1.72L8.42 3.9H6.57L17.81 20Z"/></svg></a>
                        <a href="#" aria-label="Instagram" title="Instagram"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 0C5.83 0 5.56.01 4.7.05 3.85.09 3.27.22 2.76.42c-.53.2-.97.48-1.42.92C.9 1.79.62 2.24.42 2.76.22 3.27.09 3.85.05 4.7.01 5.56 0 5.83 0 8s.01 2.44.05 3.3c.04.85.17 1.43.37 1.94.2.52.48.97.92 1.42.45.44.89.72 1.42.92.51.2 1.09.33 1.94.37.85.04 1.12.05 3.3.05s2.44-.01 3.3-.05c.85-.04 1.43-.17 1.94-.37.52-.2.97-.48 1.42-.92.44-.45.72-.9.92-1.42.2-.51.33-1.09.37-1.94.04-.86.05-1.13.05-3.3s-.01-2.44-.05-3.3c-.04-.85-.17-1.43-.37-1.94a3.9 3.9 0 0 0-.92-1.42 3.9 3.9 0 0 0-1.42-.92c-.51-.2-1.09-.33-1.94-.37C10.44.01 10.17 0 8 0Zm0 1.44c2.14 0 2.39.01 3.23.05.78.03 1.2.16 1.49.27.37.15.64.32.92.6.28.28.45.55.6.92.11.28.24.7.27 1.49.04.84.05 1.1.05 3.23s-.01 2.39-.05 3.23c-.03.78-.16 1.2-.27 1.49-.15.37-.32.64-.6.92-.28.28-.55.45-.92.6-.28.11-.7.24-1.49.27-.84.04-1.1.05-3.23.05s-2.39-.01-3.23-.05c-.78-.03-1.2-.16-1.49-.27a2.5 2.5 0 0 1-.92-.6 2.5 2.5 0 0 1-.6-.92c-.11-.28-.24-.7-.27-1.49-.04-.84-.05-1.1-.05-3.23s.01-2.39.05-3.23c.03-.78.16-1.2.27-1.49.15-.37.32-.64.6-.92.28-.28.55-.45.92-.6.28-.11.7-.24 1.49-.27.84-.04 1.1-.05 3.23-.05Zm0 2.45A4.11 4.11 0 1 0 8 12.1 4.11 4.11 0 0 0 8 3.89Zm0 1.44A2.67 2.67 0 1 1 8 10.67 2.67 2.67 0 0 1 8 5.33Zm4.27-2.56a.96.96 0 1 0 0 1.92.96.96 0 0 0 0-1.92Z"/></svg></a>
                        <a href="#" aria-label="YouTube" title="YouTube"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8.05 2h.09c.82 0 4.99.03 6.11.34a2.01 2.01 0 0 1 1.42 1.42c.2.77.33 2 .33 3.82s-.13 3.05-.33 3.82a2.01 2.01 0 0 1-1.42 1.42c-1.12.3-5.29.33-6.11.33h-.28c-.82 0-4.99-.03-6.11-.33a2.01 2.01 0 0 1-1.42-1.42C.13 10.63 0 9.4 0 7.58s.13-3.05.33-3.82a2.01 2.01 0 0 1 1.42-1.42C2.87 2.03 7.04 2 7.86 2h.19ZM6.4 5.21v4.82l4.16-2.41L6.4 5.21Z"/></svg></a>
                    </div>
                    <a href="https://tlmps.netlify.app" target="_blank" class="portal-footer-website">Visit Main Website</a>
                </div>
                <div class="col-md-4 portal-footer-copyright text-right">
                    <p><script>document.write(new Date().getFullYear())</script> &copy; All Rights Reserved.<br>Powered by <strong>TLMPS Tech</strong></p>
                </div>
            </div>
        </div>
    </footer>

    <script>
        const profileMenuToggle = document.querySelector('.student-menu-toggle');
        const profileSidebar = document.getElementById('profile-sidebar');
        profileMenuToggle.addEventListener('click', () => {
            const isOpen = profileSidebar.classList.toggle('is-open');
            profileMenuToggle.setAttribute('aria-expanded', String(isOpen));
        });
        document.addEventListener('click', (event) => {
            if (window.innerWidth < 992 && profileSidebar.classList.contains('is-open') && !profileSidebar.contains(event.target) && !profileMenuToggle.contains(event.target)) {
                profileSidebar.classList.remove('is-open');
                profileMenuToggle.setAttribute('aria-expanded', 'false');
            }
        });

    </script>
</body>
</html>
