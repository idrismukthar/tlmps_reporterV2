                            <span><a href="mailto:contacttlmps@gmail.com?subject=Enquiry%20-%20The%20Leaders%20Memorial%20Private%20School" style="color: #d1d5db; text-decoration: none;"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path d="M.05 3.555A2 2 0 0 1 2 2h12a2 2 0 0 1 1.95 1.555L8 8.414.05 3.555zM0 4.697v7.104l5.803-3.558L0 4.697zM6.761 8.83l-6.57 4.027A2 2 0 0 0 2 14h12a2 2 0 0 0 1.808-1.144l-6.57-4.027L8 9.586l-1.239-.757zM16 11.801V4.697l-5.803 3.546L16 11.801z"/></svg> contacttlmps@gmail.com</a></span>
                        </p>
					</div>
                    
                    <div class="col-md-4 md-margin-bottom-40 text-center portal-footer-social">
                        <h3>Connect With Us</h3>
                        <div class="social-icons">
                            <a href="#" title="Facebook">
