<!DOCTYPE html>
<html lang="en"><head><link rel="icon" type="image/x-icon" href="/favicon.ico"><link rel="manifest" href="/site.webmanifest"><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Teacher Dashboard - TLMPS</title><style>
:root{font-family:"Trebuchet MS",Arial,sans-serif;color:#241b35;background:#f3effb}*{box-sizing:border-box}body{margin:0;min-height:100vh;background:radial-gradient(circle at 10% 0%,#e7d9ff 0,#f3effb 38%,#eef8e9 100%)}.nav{background:linear-gradient(110deg,#4b237d,#713ca2);color:#fff;padding:18px max(20px,calc((100% - 1050px)/2));display:flex;justify-content:space-between;gap:15px;align-items:center;box-shadow:0 8px 26px #4b237d30}.nav h1{font-size:20px;margin:0}.nav a{color:#fff;border:1px solid #ffffff66;border-radius:999px;padding:9px 14px;text-decoration:none}.wrap{max-width:1050px;margin:0 auto;padding:34px 20px}.intro{margin-bottom:22px}.intro h2{margin:0 0 6px;color:#321655}.intro p{color:#685d74}.sessions{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,310px));gap:18px;align-items:start}.session{background:#ffffff9c;border:1px solid #fff;backdrop-filter:blur(14px);border-radius:16px;padding:20px;box-shadow:0 12px 30px #4b237d18}.session h3{margin:0 0 15px;color:#4b237d;font-size:22px}.terms{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.term{min-height:76px;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;border:1px solid #c8b7dd;border-radius:10px;padding:8px;text-decoration:none;color:#321655;background:#fff9}.term:hover,.term:focus{border-color:#9a70c4;background:#eee3ff}.term span:first-child{font-weight:bold;font-size:13px}.status{font-size:11px;color:#7c7088;margin-top:5px}.active{color:#5a9b2f;font-weight:bold}.empty{background:#ffffffb8;padding:24px;border-radius:12px}@media(max-width:600px){.nav{padding:15px 16px}.nav h1{font-size:15px}.wrap{padding:25px 16px}.intro h2{font-size:24px}.sessions{grid-template-columns:1fr}.session{width:100%}}
</style></head><body><nav class="nav"><h1><%= className.slice(0,3) %> <%= className.slice(3) %> | <%= subject.subject_name %></h1><a href="/teacher/logout">Logout</a></nav><main class="wrap"><section class="intro"><h2>Dashboard for <%= className.slice(0,3) %> <%= className.slice(3) %> - <%= subject.subject_name %></h2><p>Choose an active academic term to enter or update scores.</p></section><section class="sessions"><% if (!sessions.length) { %><div class="empty">No academic sessions have been created yet.</div><% } %><% sessions.forEach(session => { %><article class="session"><h3><%= session.session_name %></h3><div class="terms"><% (termsBySession[session.session_id] || []).forEach(term => { %><% if (term.term_status === 'Active') { %><a class="term" href="/teacher/scores/<%= session.session_id %>/<%= term.term_id %>"><span><%= term.term_name %></span><span class="status active">Active</span></a><% } else { %><div class="term" style="opacity:.55;cursor:not-allowed;"><span><%= term.term_name %></span><span class="status"><%= term.term_status %></span></div><% } %><% }) %></div></article><% }) %></section></main></body></html>
