<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Class Teacher Login</title><style>
body{font-family:Arial,sans-serif;background:#eef3f7;margin:0;min-height:100vh;display:grid;place-items:center}.panel{background:#fff;width:min(420px,calc(100% - 32px));padding:32px;border-radius:10px;box-shadow:0 8px 25px #183b5320}h1{margin-top:0;color:#16425b}label{display:block;font-weight:bold;margin:18px 0 6px}select,input,button{width:100%;box-sizing:border-box;padding:12px;border:1px solid #b8c5cd;border-radius:5px;font:inherit}button{margin-top:22px;background:#176b87;color:#fff;border:0;font-weight:bold;cursor:pointer}.error{background:#fff0f0;color:#a32929;padding:10px;border-radius:5px}
</style></head><body><main class="panel"><h1>Class Teacher Portal</h1><p>Sign in to manage attendance, conduct, and term remarks.</p><% if (error) { %><div class="error"><%= error %></div><% } %><form method="POST" action="/classteacher/login"><label for="class_name">Assigned class</label><select id="class_name" name="class_name" required><% classes.forEach(className => { %><option value="<%= className %>"><%= className.slice(0, 3) %> <%= className.slice(3) %></option><% }) %></select><label for="password">Password</label><input id="password" name="password" type="password" required><button type="submit">Sign in</button></form></main></body></html>