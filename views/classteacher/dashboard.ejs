<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Class Teacher Dashboard</title><style>
body{font-family:Arial,sans-serif;background:#eef3f7;margin:0;color:#20313b}.nav{background:#16425b;color:#fff;padding:18px max(18px,calc((100% - 1050px)/2));display:flex;justify-content:space-between;align-items:center}.nav a{color:#fff}.wrap{max-width:1050px;margin:auto;padding:30px 18px}.sessions{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:18px}.session{background:#fff;border:1px solid #d8e2e8;border-radius:8px;padding:20px}.terms{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.term{padding:14px 8px;text-align:center;background:#e8f4f6;color:#16425b;text-decoration:none;border-radius:5px}.empty{background:#fff;padding:20px;border-radius:8px}
</style></head><body><nav class="nav"><strong>Class Teacher | <%= className.slice(0, 3) %> <%= className.slice(3) %></strong><a href="/classteacher/logout">Logout</a></nav><main class="wrap"><h1>Academic sessions</h1><% if (!sessions.length) { %><div class="empty">No academic sessions have been created yet.</div><% } %><section class="sessions"><% sessions.forEach(session => { %><article class="session"><h2><%= session.session_name %></h2><div class="terms"><% (termsBySession[session.session_id] || []).forEach(term => { %><% if (term.term_status === 'Active') { %><a class="term" href="/classteacher/remarks/<%= session.session_id %>/<%= term.term_id %>"><%= term.term_name %></a><% } else { %><div class="term" style="opacity:.5;cursor:not-allowed;"><%= term.term_name %><br><small><%= term.term_status %></small></div><% } %><% }) %></div></article><% }) %></section></main></body></html>
