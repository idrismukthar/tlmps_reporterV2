<!doctype html>
<html lang="en">
<head><link rel="icon" type="image/x-icon" href="/favicon.ico"><link rel="manifest" href="/site.webmanifest">
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= className %> Attendance</title>
  <style>
    :root{font-family:Arial,sans-serif;color:#172033;background:#f3f4f6}
    *{box-sizing:border-box}body{margin:0}.top{background:#fff;padding:22px 5%;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #e5e7eb}
    .brand{font-size:22px;font-weight:900;letter-spacing:.03em;color:#1e3a8a}.top a{color:#64748b;font-weight:700}
    .tabs{display:flex;background:#fff;border-bottom:1px solid #e5e7eb}.tabs a{flex:1;text-align:center;padding:16px;color:#64748b;font-weight:800;text-decoration:none}.tabs a.active{color:#2563eb;border-bottom:4px solid #2563eb;background:#eff6ff}
    .date-bar{background:#fff;padding:18px;display:flex;justify-content:center;border-bottom:1px solid #e5e7eb}.date-bar label{display:flex;align-items:center;gap:10px;background:#f8fafc;border:1px solid #e5e7eb;border-radius:10px;padding:12px 14px;color:#2563eb;font-weight:800}.date-bar input{border:0;background:transparent;font-weight:800;color:#334155;font-size:16px;outline:0}
    main{max-width:720px;margin:0 auto;padding:18px 16px 50px}.heading{display:flex;gap:10px;align-items:stretch;margin-bottom:26px}.date-title{flex:1;background:#111827;color:#fff;border-radius:9px;padding:14px;text-align:center;font-size:13px;font-weight:900;line-height:1.45;text-transform:uppercase;letter-spacing:.06em;box-shadow:0 2px 5px #0002}
    .holiday-wrap{position:relative}.holiday-button{height:100%;border:1px solid #fecaca;background:#fff1f2;color:#dc2626;border-radius:9px;padding:0 14px;font-weight:900;cursor:pointer;white-space:nowrap}.holiday-menu{position:absolute;right:0;top:calc(100% + 7px);width:180px;background:#fff;border:1px solid #fecaca;border-radius:8px;padding:5px;box-shadow:0 5px 15px #0002;z-index:4}.holiday-menu label{display:block;padding:9px;color:#374151;font-size:12px;font-weight:800;cursor:pointer}.holiday-menu label:hover{background:#fff1f2;color:#dc2626}
    h2{font-size:20px;color:#1e3a8a;border-bottom:2px solid #bfdbfe;padding-bottom:8px;margin:0 0 12px}    .student{background:#fff;border:1px solid #e5e7eb;border-radius:14px;padding:14px;margin-bottom:12px;display:flex;align-items:center;justify-content:space-between;gap:12px;box-shadow:0 1px 2px #0000000d}.student-info{display:flex;align-items:center;gap:12px;min-width:0}.avatar{height:52px;width:52px;border-radius:50%;background:#ddd6fe;display:flex;align-items:center;justify-content:center;color:#6366f1;font-weight:900;flex:none;overflow:hidden;position:relative}.avatar-photo{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.student-name{font-weight:900;font-size:16px;line-height:1.25}.admission{font-size:12px;color:#2563eb;font-weight:900;margin-bottom:3px}.gender{display:inline-block;margin-top:5px;background:#e5e7eb;color:#64748b;border-radius:4px;padding:3px 8px;font-size:10px;font-weight:900}.actions{display:flex;gap:8px;flex:none}.actions button{display:flex;align-items:center;gap:5px;border:2px solid #e5e7eb;background:#fff;border-radius:9px;padding:11px 12px;font-weight:900;cursor:pointer}.actions button.absent{color:#ef4444}.actions button.present{color:#16a34a}.actions button.absent.selected{background:#ef4444;color:#fff;border-color:#dc2626}.actions button.present.selected{background:#22c55e;color:#fff;border-color:#16a34a}.toolbar{display:flex;justify-content:flex-end;margin:-12px 0 14px}.mark-all{border:0;background:#22c55e;color:#052e16;border-radius:8px;padding:10px 14px;font-weight:900;cursor:pointer}.mark-all:disabled,.save:disabled{opacity:.5;cursor:not-allowed}.save{border:0;background:#2563eb;color:#fff;border-radius:8px;padding:12px 18px;font-weight:900;cursor:pointer}.notice{background:#fff7ed;border:1px solid #fdba74;border-radius:8px;padding:12px;color:#9a3412;font-weight:700}.modal-backdrop{position:fixed;inset:0;background:#11182799;display:flex;align-items:center;justify-content:center;padding:18px;z-index:10}.modal-backdrop[hidden]{display:none}.edit-modal{width:min(100%,420px);background:#fff;border-radius:14px;padding:24px;box-shadow:0 12px 40px #0004}.edit-modal h2{margin:0 0 10px;color:#1e293b}.edit-modal p{color:#475569;line-height:1.5}.modal-actions{display:flex;justify-content:flex-end;gap:10px;margin-top:20px}.modal-actions button{border:0;border-radius:8px;padding:11px 15px;font-weight:900;cursor:pointer}.modal-no{background:#e2e8f0;color:#334155}.modal-yes{background:#2563eb;color:#fff}
    @media(max-width:560px){.top{padding:16px}.brand{font-size:18px}.student{align-items:flex-start}.student-info{max-width:48%}.actions button{padding:9px 7px;font-size:11px}.date-title{font-size:11px}.holiday-button{font-size:11px;padding:0 8px}}
  </style>
</head>
<body>
  <header class="top"><div class="brand">TLMPS ATTENDANCE</div><a href="/superadmin/attendance/<%= term.session_id %>/<%= term.term_id %>">← Classes</a></header>
  <nav class="tabs"><a class="active" href="#">Mark Attendance</a><a href="/superadmin/attendance/<%= term.session_id %>/<%= term.term_id %>/class?class_name=<%= encodeURIComponent(className) %>&view=register">View Register</a></nav>
  <div class="date-bar">
    <label>📅 <input type="date" value="<%= selectedDate %>" min="<%= dates[0] || '' %>" max="<%= dates[dates.length - 1] || '' %>" onchange="changeDate(this.value)"></label>
  </div>
  <main>
    <% if (error) { %><p class="notice"><%= error %></p><% } %>
    <form method="post" action="/superadmin/attendance/<%= term.session_id %>/<%= term.term_id %>/class" id="attendance-form">
      <input type="hidden" name="class_name" value="<%= className %>">
      <input type="hidden" name="selected_date" value="<%= selectedDate %>">
      <div class="heading">
        <div class="date-title">Attendance for <%= displayAttendanceDateLong(selectedDate) %></div>
        <div class="holiday-wrap">
          <button type="button" class="holiday-button" onclick="toggleHoliday()">Is it a holiday?⌄</button>
          <div class="holiday-menu" id="holiday-menu" hidden>
            <label><input type="checkbox" name="is_holiday" value="1" <%= dayMap[selectedDate] && dayMap[selectedDate].is_holiday ? "checked" : "" %> onchange="toggleHolidayFields(this)"> Mark this day as a holiday</label>
            <label>Reason <input type="text" name="holiday_name" value="<%= dayMap[selectedDate] ? dayMap[selectedDate].holiday_name || '' : '' %>" placeholder="Holiday"></label>
          </div>
        </div>
      </div>
      <% if (dates.length) { %>
        <h2><%= className %></h2>
        <div class="toolbar"><button type="button" class="mark-all" onclick="toggleMarkAll()" <%= !(typeof canMarkSelectedDate !== "undefined" ? canMarkSelectedDate : dates.includes(selectedDate)) || (dayMap[selectedDate] && dayMap[selectedDate].is_holiday) ? "disabled" : "" %>>✓ Mark all present</button></div>
        <% students.forEach((student) => {
          const fullName = [student.surname, student.middle_name, student.last_name].filter(Boolean).join(" ");
          const key = selectedDate + ":" + student.admission_no;
          const status = recordMap[key];
        %>
          <div class="student">
            <div class="student-info"><div class="avatar"><span><%= student.surname ? student.surname.charAt(0).toUpperCase() : "S" %></span><% if (student.passport_url) { %><img class="avatar-photo" src="<%= student.passport_url %>" alt="" onerror="this.remove()"><% } %></div><div><div class="admission"><%= student.admission_no %></div><div class="student-name"><%= fullName %></div><span class="gender">Student</span></div></div>
            <div class="actions">
              <button type="button" class="absent <%= status === 'A' ? 'selected' : '' %>" data-student="<%= student.admission_no %>" data-status="A" onclick="markStudent(this)">✕ Absent</button>
              <button type="button" class="present <%= status === 'P' ? 'selected' : '' %>" data-student="<%= student.admission_no %>" data-status="P" onclick="markStudent(this)">✓ Present</button>
              <input type="hidden" name="attendance[<%= student.admission_no %>]" value="<%= status || '' %>" id="attendance-<%= student.admission_no %>">
            </div>
          </div>
        <% }) %>
        <button class="save" type="submit" <%= !(typeof canMarkSelectedDate !== "undefined" ? canMarkSelectedDate : dates.includes(selectedDate)) ? "disabled" : "" %>>Save attendance</button>
      <% } %>
    </form>
  </main>
  <% if (typeof hasExistingAttendance !== "undefined" && hasExistingAttendance) { %>
    <div class="modal-backdrop" id="existing-attendance-modal" role="presentation">
      <section class="edit-modal" role="dialog" aria-modal="true" aria-labelledby="edit-modal-title" aria-describedby="edit-modal-description">
        <h2 id="edit-modal-title">Attendance already marked</h2>
        <p id="edit-modal-description">Attendance for <%= displayAttendanceDateLong(selectedDate) %> in <%= className %> already has saved marks. Do you want to edit it?</p>
        <div class="modal-actions">
          <button type="button" class="modal-no" onclick="viewRegister()">No, view register</button>
          <button type="button" class="modal-yes" onclick="closeEditModal()">Yes, edit</button>
        </div>
      </section>
    </div>
  <% } %>
  <script>
    function changeDate(date){if(date){window.location.href="/superadmin/attendance/<%= term.session_id %>/<%= term.term_id %>/class?class_name=<%= encodeURIComponent(className) %>&date="+encodeURIComponent(date)}}
    function markStudent(button){var admission=button.dataset.student;document.querySelectorAll('[data-student="'+admission+'"]').forEach(function(item){item.classList.toggle("selected",item===button)});document.getElementById("attendance-"+admission).value=button.dataset.status;updateMarkAllButton()}
    function updateMarkAllButton(){var inputs=Array.from(document.querySelectorAll('.student input[type="hidden"]'));var allPresent=inputs.length>0&&inputs.every(function(input){return input.value==="P"});var button=document.querySelector(".mark-all");if(button){button.textContent=allPresent?"↶ Unmark all":"✓ Mark all present";button.setAttribute("aria-pressed",allPresent?"true":"false")}}
    function toggleMarkAll(){var inputs=Array.from(document.querySelectorAll('.student input[type="hidden"]'));var allPresent=inputs.length>0&&inputs.every(function(input){return input.value==="P"});inputs.forEach(function(input){var status=allPresent?"":"P";input.value=status;document.querySelectorAll('[data-student="'+input.id.slice("attendance-".length)+'"]').forEach(function(button){button.classList.toggle("selected",button.dataset.status===status&&status!=="")})});updateMarkAllButton()}
    function toggleHoliday(){var menu=document.getElementById("holiday-menu");menu.hidden=!menu.hidden}
    function toggleHolidayFields(checkbox){document.querySelectorAll(".student").forEach(function(student){student.style.opacity=checkbox.checked?".5":"1"});document.querySelectorAll(".actions button").forEach(function(button){button.disabled=checkbox.checked});var bulkButton=document.querySelector(".mark-all");if(bulkButton){bulkButton.disabled=checkbox.checked||<%= (typeof canMarkSelectedDate !== "undefined" ? canMarkSelectedDate : dates.includes(selectedDate)) ? "false" : "true" %>}}
    function closeEditModal(){document.getElementById("existing-attendance-modal").hidden=true}
    function viewRegister(){window.location.href="/superadmin/attendance/<%= term.session_id %>/<%= term.term_id %>/class?class_name=<%= encodeURIComponent(className) %>&view=register"}
    updateMarkAllButton()
    if(document.querySelector('[name="is_holiday"]').checked){toggleHolidayFields(document.querySelector('[name="is_holiday"]'))}
  </script>
</body>
</html>
