<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%= session.session_name %> Attendance</title>
<style>body{font-family:Arial,sans-serif;background:#f4f0fa;color:#1e1b26;margin:0}.top{background:#3b1c56;color:#fff;padding:20px 6%;display:flex;justify-content:space-between}.top a{color:#fff}.wrap{max-width:1000px;margin:35px auto;padding:0 20px}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.card{background:#fff;border-radius:12px;padding:22px;border:1px solid #e2d4f0}.card a{display:block;background:#84cc16;color:#3b1c56;text-decoration:none;text-align:center;padding:11px;border-radius:7px;font-weight:bold;margin-top:18px}@media(max-width:700px){.grid{grid-template-columns:1fr}}</style>
</head>
<body><header class="top"><strong><%= session.session_name %> Attendance</strong><a href="/superadmin/attendance">← Sessions</a></header>
<main class="wrap"><h1>Select a term</h1><div class="grid">
<% if (!terms.length) { %><p>No terms are configured for this session.</p><% } %>
<% terms.forEach((term) => { %><article class="card"><h2><%= term.term_name %></h2><p><%= term.resumption_date || "Resumption date not set" %> to <%= term.vacation_date || "Vacation date not set" %></p><a href="/superadmin/attendance/<%= session.session_id %>/<%= term.term_id %>">View classes →</a></article><% }) %>
</div></main></body></html>
