<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title><%= editMode ? 'Edit Student' : 'Register Student' %> - TLMPS</title>
    <style>
        body { font-family: Arial, sans-serif; background: #f4f6f9; padding: 25px; }
        .container { max-width: 800px; margin: 0 auto; background: #fff; padding: 30px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
        .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; }
        .full-width { grid-column: span 2; }
        .form-group { margin-bottom: 12px; }
        label { display: block; font-weight: bold; margin-bottom: 5px; font-size: 14px; }
        input[type="text"], input[type="email"], select, input[type="file"] { width: 100%; padding: 8px; box-sizing: border-box; }
        
        .otp-container { display: flex; gap: 8px; justify-content: flex-start; }
        .otp-digit { width: 45px !important; height: 45px; text-align: center; font-size: 20px; font-weight: bold; border: 2px solid #0d6efd; border-radius: 6px; }

        .date-grid { display: grid; grid-template-columns: 1fr 1fr 2fr; gap: 8px; }

        .subject-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 10px; border: 1px solid #ddd; padding: 15px; border-radius: 6px; background: #fdfdfd; max-height: 250px; overflow-y: auto; }
        .subject-item { display: flex; align-items: center; gap: 8px; font-size: 13px; }
        .btn { background: #0d6efd; color: #fff; padding: 12px; border: none; border-radius: 4px; cursor: pointer; width: 100%; font-size: 16px; font-weight: bold; }
        a { display: inline-block; margin-bottom: 15px; color: #0d6efd; text-decoration: none; }
    </style>
</head>
<body>
    <div class="container">
        <a href="<%= editMode ? (session.session_id ? '/superadmin/sessions/' + session.session_id : '/superadmin/student/' + originalAdmissionNo) : '/superadmin/sessions/' + session.session_id %>">&larr; Back to <%= editMode ? 'Student Profile' : 'Session Workspace' %></a>
        <h2><%= editMode ? 'Edit Student Registration' : 'Register New Student' %> in <%= session.session_name %></h2>

        <form action="<%= editMode ? '/superadmin/student/' + originalAdmissionNo + '/edit' : '/superadmin/register-student' %>" method="POST" enctype="multipart/form-data" onsubmit="compileFormDetails()">
            <input type="hidden" name="session_id" value="<%= session.session_id %>">
            
            <div class="form-group full-width">
                <label>Unique Admission Number 5-Digit</label>
                <div class="otp-container">
                    <% for (let i = 0; i < 5; i++) { %><input type="text" class="otp-digit" maxlength="1" pattern="[0-9]" inputmode="numeric" autocomplete="off" value="<%= editMode ? originalAdmissionNo[i] : '' %>" required><% } %>
                </div>
                <input type="hidden" name="admission_no" id="final_admission_no">
            </div>

            <div class="form-grid">
                <div class="form-group">
                    <label>Class</label>
                    <select name="class_name" id="classSelect" required onchange="handleClassChange(this.value)">
                        <option value="">-- Select Class --</option>
                        <% ['JSS1', 'JSS2', 'JSS3', 'SSS1', 'SSS2', 'SSS3'].forEach(cls => { %><option value="<%= cls %>" <%= editMode && student.class_name === cls ? 'selected' : '' %>><%= cls.slice(0, 3) %> <%= cls.slice(3) %></option><% }); %>
                    </select>
                </div>

                <div class="form-group" id="deptBox" style="display: none;">
                    <label>Department</label>
                    <select name="department" id="deptSelect">
                        <option value="">-- Select Department --</option>
                        <option value="Science" <%= editMode && student.department === 'Science' ? 'selected' : '' %>>Science</option>
                        <option value="Commercial" <%= editMode && student.department === 'Commercial' ? 'selected' : '' %>>Commercial</option>
                        <option value="Humanities(Art)" <%= editMode && student.department === 'Humanities(Art)' ? 'selected' : '' %>>Humanities(Art)</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Gender</label>
                    <select name="gender" required>
                        <option value="Male" <%= editMode && student.gender === 'Male' ? 'selected' : '' %>>Male</option>
                        <option value="Female" <%= editMode && student.gender === 'Female' ? 'selected' : '' %>>Female</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Surname</label>
                    <input type="text" name="surname" value="<%= editMode ? student.surname : '' %>" required>
                </div>

                <div class="form-group">
                    <label>Middle Name</label>
                    <input type="text" name="middle_name" value="<%= editMode ? (student.middle_name || '') : '' %>">
                </div>

                <div class="form-group">
                    <label>First Name </label>
                    <input type="text" name="last_name" value="<%= editMode ? student.last_name : '' %>" required>
                </div>

                <div class="form-group">
                    <label>Date of Birth (DD / MM / YYYY)</label>
                    <div class="date-grid">
                        <select id="dob_day" required>
                            <option value="">Day</option>
                            <% for(let d = 1; d <= 31; d++) { %>
                                <option value="<%= d < 10 ? '0' + d : d %>"><%= d < 10 ? '0' + d : d %></option>
                            <% } %>
                        </select>
                        <select id="dob_month" required>
                            <option value="">Month</option>
                            <% const months = ['01','02','03','04','05','06','07','08','09','10','11','12']; %>
                            <% months.forEach(m => { %>
                                <option value="<%= m %>"><%= m %></option>
                            <% }); %>
                        </select>
                        <input type="text" id="dob_year" placeholder="YYYY" pattern="[0-9]{4}" required>
                    </div>
                    <input type="hidden" name="dob" id="final_dob">
                </div>

                <div class="form-group">
                    <label>Phone Number</label>
                    <input type="text" name="phone_number" value="<%= editMode ? (student.phone_number || '') : '' %>" required>
                </div>

                <div class="form-group">
                    <label>Email Address</label>
                    <input type="email" name="email" value="<%= editMode ? (student.email || '') : '' %>">
                </div>

                <div class="form-group">
                    <label>State of Origin</label>
                    <select name="state_of_origin" id="stateSelect" required>
                        <option value="">-- Select State --</option>
                        <% states.forEach(state => { %>
                            <option value="<%= state.name %>" <%= editMode && student.state_of_origin === state.name ? 'selected' : '' %>><%= state.name %></option>
                        <% }); %>
                    </select>
                </div>

                <div class="form-group">
                    <label>Local Government Area (LGA)</label>
                    <select name="lga" id="lgaSelect" required disabled>
                        <option value="">-- Select State First --</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Club</label>
                    <input type="text" name="club" value="<%= editMode ? (student.club || '') : '' %>" placeholder="e.g. JET Club">
                </div>

                <div class="form-group">
                    <label>Society</label>
                    <input type="text" name="society" value="<%= editMode ? (student.society || '') : '' %>" placeholder="e.g. Literary & Debating">
                </div>

                <div class="form-group full-width">
                    <label>Residential Address</label>
                    <input type="text" name="address" value="<%= editMode ? (student.address || '') : '' %>" required>
                </div>

                <div class="form-group full-width">
                    <label><%= editMode ? 'Replace Passport Photo (optional)' : 'Passport Photo (Max: 100KB)' %></label>
                    <input type="file" name="passport" id="passportInput" accept="image/*" <%= editMode ? '' : 'required' %>>
                    <p id="passportMessage" style="margin: 6px 0 0; color: #6c757d; font-size: 13px;"></p>
                </div>
            </div>

            <div class="form-group full-width" style="margin-top: 15px;">
                <label>Select Offered Subjects</label>
                <div class="subject-grid">
                    <% subjects.forEach(sub => { %>
                        <div class="subject-item sub-card" data-category="<%= sub.level_category %>" data-unit="<%= sub.unit_weight %>">
                            <input type="checkbox" name="subject_ids" value="<%= sub.subject_id %>" id="sub_<%= sub.subject_id %>" <%= editMode && selectedSubjectIds.includes(sub.subject_id) ? 'checked' : '' %>>
                            <label for="sub_<%= sub.subject_id %>" style="font-weight: normal; margin: 0; cursor: pointer;">
                                <%= sub.subject_name %> 
                                <% if (sub.level_category === 'SSS') { %>
                                    <strong>(<%= sub.unit_weight %> Unit<%= sub.unit_weight > 1 ? 's' : '' %>)</strong>
                                <% } %>
                            </label>
                        </div>
                    <% }); %>
                </div>
            </div>

            <button type="submit" class="btn" style="margin-top: 20px;"><%= editMode ? 'Save Student Changes' : 'Complete Student Registration' %></button>
        </form>
    </div>

    <script type="application/json" id="statesData"><%- JSON.stringify(states) %></script>
    <script>
        const registrationForm = document.querySelector('form[action="/superadmin/register-student"]');
        const otpDigits = Array.from(document.querySelectorAll('.otp-digit'));
        const passportInput = document.getElementById('passportInput');
        const passportMessage = document.getElementById('passportMessage');
        const stateSelect = document.getElementById('stateSelect');
        const lgaSelect = document.getElementById('lgaSelect');
        const states = JSON.parse(document.getElementById('statesData').textContent);

        otpDigits.forEach((input, index) => {
            input.addEventListener('focus', () => {
                const firstEmpty = otpDigits.findIndex((digit) => !digit.value);
                if (firstEmpty !== -1 && firstEmpty < index) otpDigits[firstEmpty].focus();
            });
            input.addEventListener('input', () => {
                input.value = input.value.replace(/\D/g, '').slice(-1);
                if (input.value && index < otpDigits.length - 1) otpDigits[index + 1].focus();
            });
            input.addEventListener('keydown', (event) => {
                if (event.key === 'Backspace' && !input.value && index > 0) {
                    otpDigits[index - 1].value = '';
                    otpDigits[index - 1].focus();
                }
            });
            input.addEventListener('paste', (event) => {
                event.preventDefault();
                const pasted = (event.clipboardData.getData('text') || '').replace(/\D/g, '').slice(0, 5);
                pasted.split('').forEach((digit, offset) => {
                    if (otpDigits[offset]) otpDigits[offset].value = digit;
                });
                otpDigits[Math.min(pasted.length, otpDigits.length - 1)].focus();
            });
        });

        stateSelect.addEventListener('change', () => {
            const selectedState = states.find((state) => state.name === stateSelect.value);
            lgaSelect.innerHTML = '<option value="">-- Select LGA --</option>';
            lgaSelect.disabled = !selectedState;
            if (selectedState) {
                selectedState.lgas.forEach((lga) => {
                    const option = document.createElement('option');
                    option.value = lga;
                    option.textContent = lga;
                    <% if (editMode) { %>option.selected = lga === <%- JSON.stringify(student.lga || '') %>;<% } %>
                    lgaSelect.appendChild(option);
                });
            }
        });

        passportInput.addEventListener('change', () => {
            const file = passportInput.files[0];
            if (!file) {
                passportMessage.textContent = '';
                return;
            }
            if (file.size > 100 * 1024) {
                passportMessage.textContent = `This file is ${(file.size / 1024).toFixed(1)} KB. Please choose an image no larger than 100 KB.`;
                passportMessage.style.color = '#dc3545';
                passportInput.setCustomValidity('Passport photo must be no larger than 100 KB.');
            } else {
                passportMessage.textContent = `Selected file: ${(file.size / 1024).toFixed(1)} KB.`;
                passportMessage.style.color = '#198754';
                passportInput.setCustomValidity('');
            }
        });

        function compileFormDetails() {
            // Compile OTP
            const digits = document.querySelectorAll('.otp-digit');
            let pin = '';
            digits.forEach(d => pin += d.value);
            document.getElementById('final_admission_no').value = pin;

            // Compile DOB into DD/MM/YYYY
            const day = document.getElementById('dob_day').value;
            const month = document.getElementById('dob_month').value;
            const year = document.getElementById('dob_year').value;
            document.getElementById('final_dob').value = `${day}/${month}/${year}`;
        }

        <% if (editMode) { %>
        const existingDob = <%- JSON.stringify(student.dob || '') %>.split('/');
        if (existingDob.length === 3) {
            document.getElementById('dob_day').value = existingDob[0];
            document.getElementById('dob_month').value = existingDob[1];
            document.getElementById('dob_year').value = existingDob[2];
        }
        stateSelect.dispatchEvent(new Event('change'));
        <% } %>

        function handleClassChange(selectedClass) {
            const isSenior = selectedClass.startsWith('SSS');
            const targetCategory = isSenior ? 'SSS' : 'JSS';

            // Toggle Department Field
            const deptBox = document.getElementById('deptBox');
            const deptSelect = document.getElementById('deptSelect');
            if (isSenior) {
                deptBox.style.display = 'block';
                deptSelect.required = true;
            } else {
                deptBox.style.display = 'none';
                deptSelect.required = false;
                deptSelect.value = '';
            }

            // Filter and Check subjects
            document.querySelectorAll('.sub-card').forEach(card => {
                const category = card.dataset.category;
                const unit = parseInt(card.dataset.unit);
                const checkbox = card.querySelector('input');

                if (category === targetCategory) {
                    card.style.display = 'flex';
                    checkbox.disabled = false;
                    
                    <% if (!editMode) { %>
                    if (isSenior) {
                        // Tick ONLY 3-Unit subjects for SSS
                        checkbox.checked = (unit === 3);
                    } else {
                        // Tick all by default for JSS
                        checkbox.checked = true;
                    }
                    <% } %>
                } else {
                    card.style.display = 'none';
                    checkbox.disabled = true;
                    checkbox.checked = false;
                }
            });
        }

        handleClassChange(document.getElementById('classSelect').value);
    </script>
</body>
</html>