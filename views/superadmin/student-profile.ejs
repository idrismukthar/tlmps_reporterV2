<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Student Profile - <%= student.admission_no %></title>
    <style>
        body { font-family: Arial, sans-serif; background: #f4f6f9; padding: 25px; }
        .container { max-width: 800px; margin: 0 auto; background: #fff; padding: 30px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.08); }
        .profile-header { display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #0d6efd; padding-bottom: 15px; margin-bottom: 20px; }
        .passport-box { width: 100px; height: 100px; border: 2px solid #0d6efd; border-radius: 6px; overflow: hidden; }
        .passport-box img { width: 100%; height: 100%; object-fit: cover; }
        .info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; }
        .info-item { background: #f8f9fa; padding: 10px; border-radius: 4px; border-left: 3px solid #0d6efd; }
        .info-item label { display: block; font-size: 12px; color: #6c757d; text-transform: uppercase; font-weight: bold; }
        .info-item span { font-size: 15px; font-weight: bold; color: #212529; }
        .btn-pdf, .btn-edit { display: inline-block; color: white; padding: 12px 20px; text-decoration: none; border-radius: 5px; font-weight: bold; margin-top: 25px; text-align: center; }
        .btn-pdf { background: #198754; }
        .btn-edit { background: #0d6efd; margin-right: 8px; }
        a.back-btn { display: inline-block; margin-bottom: 15px; color: #0d6efd; text-decoration: none; font-weight: bold; }
    </style>
</head>
<body>
    <div class="container">
        <a href="/superadmin/all-students" class="back-btn">&larr; Back to Students Roster</a>

        <div class="profile-header">
            <div>
                <h2 style="margin: 0;"><%= student.surname %> <%= student.middle_name || '' %> <%= student.last_name %></h2>
                <p style="margin: 5px 0 0; color: #6c757d;">Admission Number: <strong><%= student.admission_no %></strong></p>
            </div>
            <div class="passport-box">
                <% if (student.passport_url) { %>
                    <img src="<%= student.passport_url %>" alt="Passport">
                <% } else { %>
                    <div style="text-align: center; padding-top: 35px; color: #888; font-size: 12px;">No Image</div>
                <% } %>
            </div>
        </div>

        <div class="info-grid">
            <div class="info-item"><label>Class</label><span><%= student.class_name %></span></div>
            <div class="info-item"><label>Department</label><span><%= student.department || 'N/A' %></span></div>
            <div class="info-item"><label>Gender</label><span><%= student.gender %></span></div>
            <div class="info-item"><label>Date of Birth</label><span><%= student.dob %></span></div>
            <div class="info-item"><label>Phone Number</label><span><%= student.phone_number %></span></div>
            <div class="info-item"><label>Email</label><span><%= student.email || 'N/A' %></span></div>
            <div class="info-item"><label>State of Origin</label><span><%= student.state_of_origin %></span></div>
            <div class="info-item"><label>LGA</label><span><%= student.lga %></span></div>
            <div class="info-item"><label>Club</label><span><%= student.club || 'N/A' %></span></div>
            <div class="info-item"><label>Society</label><span><%= student.society || 'N/A' %></span></div>
            <div class="info-item" style="grid-column: span 2;"><label>Residential Address</label><span><%= student.address %></span></div>
        </div>

        <h3 style="margin-top: 25px;">Enrolled Subjects</h3>
        <ul>
            <% enrolledSubjects.forEach(sub => { %>
                <li><%= sub.subject_name %> <% if(sub.level_category === 'SSS') { %>(<%= sub.unit_weight %> Unit<%= sub.unit_weight > 1 ? 's' : '' %>)<% } %></li>
            <% }); %>
        </ul>

        <a href="/superadmin/student/<%= student.admission_no %>/edit" class="btn-edit">Edit Profile</a>
        <a href="/superadmin/download-pdf/<%= student.admission_no %>" class="btn-pdf">
            📥 Download Registration Slip (PDF)
        </a>
    </div>
</body>
</html>