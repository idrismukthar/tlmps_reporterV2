<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Manage Sessions & Terms - TLMPS</title>
    <style>
        body { font-family: Arial, sans-serif; background: #f4f6f9; padding: 30px; }
        .card { max-width: 600px; margin: 0 auto 20px; background: #fff; padding: 25px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
        .form-group { margin-bottom: 15px; }
        label { display: block; font-weight: bold; margin-bottom: 5px; }
        input, select { width: 100%; padding: 8px; box-sizing: border-box; }
        .btn { background: #0d6efd; color: #fff; padding: 10px; border: none; border-radius: 4px; cursor: pointer; width: 100%; font-weight: bold; }
        .btn-success { background: #198754; }
        a { display: inline-block; margin-bottom: 15px; color: #0d6efd; text-decoration: none; }
        .term-card { border: 1px solid #ddd; padding: 15px; border-radius: 6px; margin-top: 15px; background: #fafafa; }
    </style>
</head>
<body>
    <div class="card">
        <a href="/superadmin/dashboard">&larr; Back to Dashboard</a>
        <h2>1. Create Academic Session</h2>
        <form action="/superadmin/create-session" method="POST">
            <div class="form-group">
                <label>Select Session Preset</label>
                <select id="sessionPreset" onchange="syncSessionInput(this.value)">
                    <% for(let y = 2020; y <= 2031; y++) { 
                        let optionVal = y + "/" + (y + 1);
                    %>
                        <option value="<%= optionVal %>" <%= optionVal === '2025/2026' ? 'selected' : '' %>><%= optionVal %></option>
                    <% } %>
                    <option value="custom">-- Type Custom Session --</option>
                </select>
            </div>

            <div class="form-group">
                <label>Session Name (Format: YYYY/YYYY)</label>
                <input type="text" id="session_name" name="session_name" value="2025/2026" pattern="^[0-9]{4}\/[0-9]{4}$" title="Enter a valid session like 2025/2026" required>
            </div>

            <button type="submit" class="btn">Create Session</button>
        </form>
    </div>

    <div class="card">
        <h2>2. Academic Session Workspaces</h2>
        <% if (!sessions || sessions.length === 0) { %>
            <p>No academic sessions have been created yet.</p>
        <% } else { %>
            <% sessions.slice().reverse().forEach(session => { %>
                <div class="term-card">
                    <strong><%= session.session_name %></strong>
                    <a href="/superadmin/sessions/<%= session.session_id %>" style="float: right;">Open Workspace</a>
                </div>
            <% }); %>
        <% } %>
    </div>

    <script>
        function syncSessionInput(val) {
            const input = document.getElementById('session_name');
            if (val !== 'custom') {
                input.value = val;
            } else {
                input.value = '';
                input.focus();
            }
        }
    </script>
</body>
</html>